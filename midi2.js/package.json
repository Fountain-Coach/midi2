{
  "name": "@fountain-coach/midi2",
  "version": "0.11.0",
  "private": false,
  "description": "Cross-browser, CoreMIDI-free MIDI 2.0 protocol and scheduler core.",
  "license": "MIT",
  "author": "Fountain Coach",
  "repository": {
    "type": "git",
    "url": "https://github.com/fountain-coach/midi2.git",
    "directory": "midi2.js"
  },
  "bugs": {
    "url": "https://github.com/fountain-coach/midi2/issues"
  },
  "homepage": "https://github.com/Fountain-Coach/midi2#readme",
  "keywords": [
    "midi",
    "midi2",
    "midi-2.0",
    "ump",
    "universal-midi-packet",
    "midi-ci",
    "sysex",
    "music",
    "audio",
    "web-midi",
    "scheduler"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "codegen": "node ./scripts/generate-openapi-types.mjs",
    "build": "npm run codegen && tsup src/index.ts --dts --format esm,cjs --target es2020 --sourcemap --out-dir dist",
    "check": "npm run codegen && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "ci": "npm run codegen && npm run check && npm test"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "@types/node": "^25.3.5",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
