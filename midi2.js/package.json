{
  "name": "@fountain-coach/midi2",
  "version": "0.0.1",
  "private": true,
  "description": "Cross-browser, CoreMIDI-free MIDI 2.0 protocol and scheduler core.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "codegen": "node ./scripts/generate-openapi-types.mjs",
    "build": "npm run codegen && tsc -p tsconfig.json",
    "check": "npm run codegen && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "ci": "npm run codegen && npm run check && npm test"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^1.6.0"
  }
}
