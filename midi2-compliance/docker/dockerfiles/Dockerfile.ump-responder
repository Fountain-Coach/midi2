FROM swift:6.1-jammy

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    libasound2-dev alsa-utils pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

# Copy entire repo and build the Linux responder
COPY . /work
RUN swift build -c release --product midi2umpd

COPY midi2-compliance/docker/scripts/run-ump-responder.sh /usr/local/bin/run-ump-responder.sh
RUN chmod +x /usr/local/bin/run-ump-responder.sh
