FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config libasound2-dev alsa-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

COPY midi2-compliance/docker/src/ump_responder.c /work/ump_responder.c
RUN gcc -O2 -o /usr/local/bin/ump_responder /work/ump_responder.c -lasound

COPY midi2-compliance/docker/scripts/run-ump-responder.sh /usr/local/bin/run-ump-responder.sh
RUN chmod +x /usr/local/bin/run-ump-responder.sh

